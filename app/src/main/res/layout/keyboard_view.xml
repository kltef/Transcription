<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/keyboard_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/kb_background"
    android:paddingHorizontal="4dp"
    android:paddingBottom="6dp"
    android:paddingTop="4dp">

    <!-- Top toolbar: keyboard switch, settings, live status, and the dictation mic. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="4dp">

        <ImageButton
            android:id="@+id/switch_ime"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/icon_button_bg"
            android:src="@drawable/ic_keyboard"
            android:contentDescription="@string/switch_ime_content_desc" />

        <ImageButton
            android:id="@+id/settings_key"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/icon_button_bg"
            android:src="@drawable/ic_settings"
            android:contentDescription="@string/settings_content_desc" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/kb_hint"
            android:textSize="13sp"
            android:text="@string/tap_to_dictate" />

        <ImageButton
            android:id="@+id/mic_button"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/mic_button_bg"
            android:backgroundTint="@color/mic_idle"
            android:src="@drawable/ic_mic"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:contentDescription="@string/mic_content_desc" />
    </LinearLayout>

    <!-- Key rows are built programmatically by KeyboardLayout into this container. -->
    <LinearLayout
        android:id="@+id/keys_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
</LinearLayout>
