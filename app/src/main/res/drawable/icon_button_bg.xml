<?xml version="1.0" encoding="utf-8"?>
<!-- Borderless circular press feedback that does NOT depend on the host theme.
     Used for toolbar icons inside the IME window, where ?attr/... may not resolve. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/kb_key_pressed">
    <item android:id="@android:id/mask">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
</ripple>
